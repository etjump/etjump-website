---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { RELEASES_URL } from '../consts';
import { buildLabel, formatReleaseDate, formatSize } from '../lib/releases';
import { loadReleaseData } from '../lib/releases.server';

const { stable, dev, older } = await loadReleaseData();

const stableChangelog = `https://github.com/etjump/etjump/blob/dev/changelog.md#etjump-${stable.tag.replaceAll('.', '')}`;
const stableDate = formatReleaseDate(stable.publishedAt);
const stableSize = formatSize(stable.size);
const devBuild = buildLabel(dev?.assetName ?? null);
const devDate = formatReleaseDate(dev?.publishedAt ?? null);
const devSize = formatSize(dev?.size ?? null);

const olderDate = formatReleaseDate(older[0]?.publishedAt ?? null);
const olderSize = formatSize(older[0]?.size ?? null);

const platforms = [
	{ name: 'Windows', arch: '32/64-bit' },
	{ name: 'Linux', arch: '32/64-bit' },
	{ name: 'macOS', arch: 'x86_64 / arm64' },
];

interface Engine {
	name: string;
	description: string;
	href: string | null;
	recommended: boolean;
}

const engines: Engine[] = [
	{
		name: 'ET: Legacy',
		description:
			'A modern, actively maintained source port of Wolfenstein: Enemy Territory. Includes a full installer for the game.',
		href: 'https://www.etlegacy.com/download',
		recommended: true,
	},
	{
		name: 'ETe',
		description:
			'A source port closely based on the improvements made on Quake3e. More minimal than ET: Legacy - no installer/game assets, requires an existing ET 2.60b installation.',
		href: 'https://github.com/etfdevs/ETe/releases/tag/latest',
		recommended: true,
	},
	{
		name: 'ET 2.60b',
		description:
			'The original Wolfenstein: Enemy Territory release. Functional, but lacks many modern features that source ports provide.',
		href: 'https://www.splashdamage.com/games/wolfenstein-enemy-territory/',
		recommended: false,
	},
	{
		name: 'ET 2.60b (Steam)',
		description: '2022 Steam release of the original ET 2.60b.',
		href: 'https://store.steampowered.com/app/1873030/Wolfenstein_Enemy_Territory/',
		recommended: false,
	},
];
---

<BaseLayout title="Downloads" description="Download the latest ETJump release, development builds and older versions.">
	<header class="downloads-intro">
		<h1>Downloads</h1>
		<p class="lede">Everything you need to get started with playing or hosting a server.</p>
		<p class="downloads-intro__note">
			ETJump is a mod. You need an existing Wolfenstein: Enemy Territory installation to play.
		</p>
	</header>

	<section class="downloads-latest" aria-label="Latest release">
		<article class="release release--stable release--banner">
			<div class="release__main">
				<p class="release__eyebrow">
					<span class="badge accent">Stable release</span>
					<span class="badge">Recommended</span>
				</p>
				<h2 data-stable-title>ETJump {stable.tag}</h2>
				<p class="release__description">
					The latest stable version, recommended for players and server operators.
					<br />
					The package contains the binaries for all supported platforms.
				</p>

				<ul class="platforms" aria-label="Supported platforms">
					{platforms.map((platform) => (
						<li class="platform">
							<span class="platform__name">{platform.name}</span>
							<span class="platform__arch">{platform.arch}</span>
						</li>
					))}
				</ul>

				<p class="release__meta" data-stable-meta>
					{stableDate && <span>Released {stableDate}</span>}
					{stableSize && (
						<span>
							{stableDate && <span aria-hidden="true">·&nbsp;</span>}
							{stableSize}
						</span>
					)}
				</p>
			</div>

			<div class="release__side">
				<div class="release__actions">
					<a class="button" href={stable.downloadUrl ?? stable.url} data-stable-download hidden={!stable.downloadUrl}>
						<Icon name="download" size={18} />
						Download
					</a>
					<a class="button secondary" href={stableChangelog} data-stable-changelog>
						Release notes
					</a>
				</div>

				<a class="release__link" href={stable.url} data-stable-page>
					View on GitHub
					<Icon name="arrow" size={14} />
				</a>
			</div>
		</article>
	</section>

	<section class="section">
		<div class="section-head">
			<div>
				<h2>Game engines</h2>
				<p>ETJump is compatible with the original game, as well as the major source ports.</p>
			</div>
		</div>

		<div class="engine-grid">
			{engines.map((engine) => {
				const Tag = engine.href ? 'a' : 'div';

				return (
					<Tag
						class:list={['card', 'engine-card', { 'engine-card--pending': !engine.href }]}
						href={engine.href ?? undefined}
					>
						<div class="engine-card__head">
							<span class="engine-card__icon">
								<Icon name="cube" />
							</span>
							{engine.recommended && <span class="badge accent">Recommended</span>}
						</div>
						<h3>{engine.name}</h3>
						<p>{engine.description}</p>
						{engine.href ? (
							<span class="engine-card__link">
								Download
								<Icon name="arrow" size={14} />
							</span>
						) : (
							<span class="engine-card__pending">Download link coming soon</span>
						)}
					</Tag>
				);
			})}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<div>
				<h2>Other releases</h2>
				<p>Older versions and the rolling development build.</p>
			</div>
			<a href={RELEASES_URL}>All releases on GitHub</a>
		</div>

		<div class="other-releases">
			<div class="release-picker" data-release-picker hidden={older.length === 0}>
				<div class="release-picker__head">
					<h3>Old releases</h3>
					<p>
						Note that old releases are unsupported. They are provided here for historical reasons. Operating system
						support varies.
					</p>
				</div>

				<label for="release-select">Version</label>
				<div class="release-picker__controls">
					<select id="release-select" data-release-select>
						{older.map((release) => (
							<option
								value={release.tag}
								data-download={release.downloadUrl ?? ''}
								data-page={release.url}
								data-date={formatReleaseDate(release.publishedAt) ?? ''}
								data-size={formatSize(release.size) ?? ''}
							>
								ETJump {release.tag}
							</option>
						))}
					</select>

					<a
						class="button secondary"
						data-release-download
						href={older[0]?.downloadUrl ?? older[0]?.url ?? RELEASES_URL}
					>
						{older[0]?.downloadUrl ? `Download ${older[0].tag}` : 'View release'}
					</a>
				</div>

				<p class="release-picker__meta">
					<span data-release-meta>
						<span data-release-date hidden={!olderDate}>
							{olderDate}
						</span>
						<span data-release-sep aria-hidden="true" hidden={!(olderDate && olderSize)}>
							·
						</span>
						<span data-release-size hidden={!olderSize}>
							{olderSize}
						</span>
					</span>
					<a data-release-page href={older[0]?.url ?? RELEASES_URL}>
						View on GitHub
					</a>
				</p>
			</div>

			<p class="muted" data-release-fallback hidden={older.length > 0}>
				Older releases are available on <a href={RELEASES_URL}>GitHub</a>.
			</p>

			<article class="release release--dev">
				<p class="release__eyebrow">
					<span class="badge">Development build</span>
				</p>
				<h3>Latest build</h3>
				<p class="release__description">
					Latest build from the development branch. Potentially unstable and buggy - use at your own risk. Not
					recommended for server operators.
				</p>

				<div data-dev-content hidden={!dev}>
					<p class="release__meta" data-dev-meta>
						{devBuild && <span class="release__build">{devBuild}</span>}
						{devDate && <span>Built {devDate}</span>}
						{devSize && (
							<span>
								{devDate && <span aria-hidden="true">·&nbsp;</span>}
								{devSize}
							</span>
						)}
					</p>

					<div class="release__actions">
						<a
							class="button secondary"
							href={dev?.downloadUrl ?? dev?.url ?? RELEASES_URL}
							data-dev-download
							hidden={!dev?.downloadUrl}
						>
							<Icon name="download" size={18} />
							Download build
						</a>
						<a class="button ghost" href={dev?.url ?? RELEASES_URL} data-dev-page>
							View release
							<Icon name="arrow" size={14} />
						</a>
					</div>
				</div>

				<p class="release__unavailable" data-dev-unavailable hidden={!!dev}>
					The development build is unavailable right now. Check the
					<a href={RELEASES_URL}> releases page</a> on GitHub.
				</p>
			</article>
		</div>
	</section>
</BaseLayout>

<script>
	import {
		RELEASES_API,
		buildLabel,
		formatReleaseDate,
		formatSize,
		selectReleases,
		toRelease,
		type GithubRelease,
		type Release,
	} from '../lib/releases';

	// The markup is rendered at build time; this only refreshes it from the
	// GitHub API. A short session cache mirrors the repository activity feed.
	const cacheKey = 'etj-releases';
	const cacheTtl = 5 * 60 * 1000;

	const stableTitle = document.querySelector<HTMLElement>('[data-stable-title]');
	const stableMeta = document.querySelector<HTMLElement>('[data-stable-meta]');
	const stableDownload = document.querySelector<HTMLAnchorElement>('[data-stable-download]');
	const stableChangelog = document.querySelector<HTMLAnchorElement>('[data-stable-changelog]');
	const stablePage = document.querySelector<HTMLAnchorElement>('[data-stable-page]');

	const devContent = document.querySelector<HTMLElement>('[data-dev-content]');
	const devUnavailable = document.querySelector<HTMLElement>('[data-dev-unavailable]');
	const devMeta = document.querySelector<HTMLElement>('[data-dev-meta]');
	const devDownload = document.querySelector<HTMLAnchorElement>('[data-dev-download]');
	const devPage = document.querySelector<HTMLAnchorElement>('[data-dev-page]');

	const picker = document.querySelector<HTMLElement>('[data-release-picker]');
	const pickerFallback = document.querySelector<HTMLElement>('[data-release-fallback]');
	const select = document.querySelector<HTMLSelectElement>('[data-release-select]');
	const download = document.querySelector<HTMLAnchorElement>('[data-release-download]');
	const date = document.querySelector<HTMLElement>('[data-release-date]');
	const separator = document.querySelector<HTMLElement>('[data-release-sep]');
	const size = document.querySelector<HTMLElement>('[data-release-size]');
	const page = document.querySelector<HTMLAnchorElement>('[data-release-page]');

	interface MetaPart {
		text: string | null;
		className?: string;
	}

	const renderMeta = (container: HTMLElement | null, parts: MetaPart[]) => {
		if (!container) return;

		const children: Node[] = [];

		for (const part of parts) {
			if (!part.text) continue;

			if (children.length > 0) {
				const dot = document.createElement('span');
				dot.setAttribute('aria-hidden', 'true');
				dot.textContent = '·';
				children.push(dot);
			}

			const span = document.createElement('span');
			if (part.className) span.className = part.className;
			span.textContent = part.text;
			children.push(span);
		}

		container.replaceChildren(...children);
	};

	const renderStable = (release: Release) => {
		if (stableTitle) stableTitle.textContent = `ETJump ${release.tag}`;

		renderMeta(stableMeta, [
			{ text: release.publishedAt ? `Released ${formatReleaseDate(release.publishedAt)}` : null },
			{ text: formatSize(release.size) },
		]);

		if (stableDownload) {
			stableDownload.href = release.downloadUrl ?? release.url;
			stableDownload.hidden = !release.downloadUrl;
		}

		if (stableChangelog) {
			const anchor = release.tag.replaceAll('.', '');
			stableChangelog.href = `https://github.com/etjump/etjump/blob/dev/changelog.md#etjump-${anchor}`;
		}

		if (stablePage) stablePage.href = release.url;
	};

	const renderDev = (release: Release | null) => {
		if (devContent) devContent.hidden = !release;
		if (devUnavailable) devUnavailable.hidden = !!release;
		if (!release) return;

		renderMeta(devMeta, [
			{ text: buildLabel(release.assetName), className: 'release__build' },
			{ text: release.publishedAt ? `Built ${formatReleaseDate(release.publishedAt)}` : null },
			{ text: formatSize(release.size) },
		]);

		if (devDownload) {
			devDownload.href = release.downloadUrl ?? release.url;
			devDownload.hidden = !release.downloadUrl;
		}

		if (devPage) devPage.href = release.url;
	};

	const renderOlder = (releases: Release[]) => {
		if (picker) picker.hidden = releases.length === 0;
		if (pickerFallback) pickerFallback.hidden = releases.length > 0;

		if (select) {
			select.replaceChildren(
				...releases.map((release) => {
					const option = document.createElement('option');
					option.value = release.tag;
					option.dataset.download = release.downloadUrl ?? '';
					option.dataset.page = release.url;
					option.dataset.date = formatReleaseDate(release.publishedAt) ?? '';
					option.dataset.size = formatSize(release.size) ?? '';
					option.textContent = `ETJump ${release.tag}`;
					return option;
				}),
			);

			select.value = releases[0]?.tag ?? '';
		}

		updatePicker();
	};

	function updatePicker() {
		if (!select || !download) return;

		const option = select.selectedOptions[0];
		if (!option) return;

		const asset = option.dataset.download;
		download.href = asset || option.dataset.page || download.href;
		download.textContent = asset ? `Download ${option.value}` : 'View release';

		if (date) {
			date.textContent = option.dataset.date ?? '';
			date.hidden = !option.dataset.date;
		}
		if (size) {
			size.textContent = option.dataset.size ?? '';
			size.hidden = !option.dataset.size;
		}
		if (separator) separator.hidden = !(option.dataset.date && option.dataset.size);
		if (page && option.dataset.page) page.href = option.dataset.page;
	}

	const apply = (releases: Release[]) => {
		const { stable, dev, older } = selectReleases(releases);

		// Without a stable release the build-time snapshot is the best we have.
		if (stable) renderStable(stable);
		renderDev(dev);
		renderOlder(older);
	};

	const readCache = (): Release[] | null => {
		try {
			const raw = sessionStorage.getItem(cacheKey);
			if (!raw) return null;

			const parsed = JSON.parse(raw) as { at: number; releases: Release[] };
			return Date.now() - parsed.at < cacheTtl ? parsed.releases : null;
		} catch {
			return null;
		}
	};

	const writeCache = (releases: Release[]) => {
		try {
			sessionStorage.setItem(cacheKey, JSON.stringify({ at: Date.now(), releases }));
		} catch {
			// Storage can be unavailable; the page still works without it.
		}
	};

	const cached = readCache();
	if (cached) {
		apply(cached);
	} else {
		fetch(RELEASES_API, { headers: { Accept: 'application/vnd.github+json' } })
			.then((response) => {
				if (!response.ok) throw new Error(`GitHub responded ${response.status}`);
				return response.json() as Promise<GithubRelease[]>;
			})
			.then((raw) => {
				const releases = raw.map(toRelease);
				apply(releases);
				writeCache(releases);
			})
			.catch((error) => {
				// Keep the build-time snapshot instead of blanking the page.
				console.warn(`[downloads] Could not refresh releases: ${error}`);
			});
	}

	select?.addEventListener('change', updatePicker);
	updatePicker();
</script>

<style>
	.downloads-intro {
		max-width: 46rem;
	}

	.downloads-intro .lede {
		margin-bottom: 0.75rem;
	}

	.downloads-intro__note {
		margin: 0;
		color: var(--etj-muted);
		font-size: 0.9rem;
	}

	.downloads-latest {
		margin-top: clamp(2rem, 5vw, 3rem);
	}

	.release {
		display: flex;
		flex-direction: column;
		padding: 1.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: var(--etj-surface);
	}

	.release--stable {
		border-color: color-mix(in srgb, var(--etj-accent) 45%, var(--etj-border));
		background: color-mix(in srgb, var(--etj-accent) 5%, var(--etj-surface));
	}

	.release--banner {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1.5rem 2.5rem;
		align-items: center;
		padding: 1.75rem 2rem;
	}

	.release--banner h2 {
		font-size: clamp(1.6rem, 3vw, 1.9rem);
	}

	.release__side {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.75rem;
	}

	.release__side .release__actions {
		margin-top: 0;
	}

	.release__side .release__link {
		margin-top: 0;
	}

	.release__eyebrow {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0 0 0.75rem;
		padding: 0 0 1rem;
	}

	.release h2 {
		margin: 0 0 0.4rem;
		font-size: 1.6rem;
	}

	.release h3 {
		margin: 0 0 0.4rem;
		font-size: 1.25rem;
	}

	.release p {
		margin: 0;
		color: var(--etj-muted);
	}

	.release__description {
		font-size: 0.95rem;
	}

	.platforms {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.platform {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35rem;
		padding: 0.22rem 0.6rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius-sm);
		background: var(--etj-surface-2);
		font-size: 0.76rem;
		line-height: 1.5;
	}

	.platform__name {
		color: var(--etj-fg-strong);
		font-weight: 600;
	}

	.platform__arch {
		color: var(--etj-muted);
		font-family: var(--etj-font-mono);
		font-size: 0.72rem;
	}

	.release .release__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		margin-top: 0.9rem;
		font-family: var(--etj-font-mono);
		font-size: 0.76rem;
		color: var(--etj-muted);
	}

	/* The build label is re-created by the client script, so this rule cannot be
	   scoped - a client-made span never carries the scope attribute. */
	:global(.release__build) {
		color: var(--etj-accent);
	}

	.release__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.25rem;
	}

	.release .release__link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 0.9rem;
		color: var(--etj-muted);
		font-size: 0.85rem;
	}

	.release .release__link:hover {
		color: var(--etj-fg-strong);
	}

	.release .release__unavailable {
		margin-top: 0.9rem;
		font-size: 0.9rem;
	}

	/* Author display values beat the UA's [hidden] rule; restore it for links
	   and blocks that the client script toggles. */
	.release a[hidden],
	.release-picker[hidden] {
		display: none;
	}

	/* Lets the static date/size spans share the meta row's flex gap. */
	[data-release-meta] {
		display: contents;
	}

	.other-releases {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: 1rem;
		align-items: stretch;
	}

	.release-picker {
		display: grid;
		gap: 0.5rem;
		align-content: start;
		padding: 1.5rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: var(--etj-surface);
	}

	.release-picker__head {
		margin-bottom: 0.5rem;
	}

	.release-picker__head h3 {
		margin: 0 0 0.25rem;
	}

	.release-picker__head p {
		margin: 0;
		color: var(--etj-muted);
		font-size: 0.9rem;
	}

	.release-picker label {
		color: var(--etj-muted);
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.release-picker__controls {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.release-picker select {
		flex: 1 1 18rem;
		min-width: 0;
		padding: 0.55rem 0.75rem;
		border: 1px solid var(--etj-border);
		border-radius: var(--etj-radius);
		background: var(--etj-bg);
		color: var(--etj-fg);
		font: inherit;
		font-size: 0.95rem;
	}

	.release-picker select:hover {
		border-color: var(--etj-border-strong);
	}

	.release-picker__meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		margin: 0;
		color: var(--etj-muted);
		font-size: 0.82rem;
	}

	.engine-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.engine-card {
		display: flex;
		flex-direction: column;
	}

	.engine-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
	}

	.engine-card__icon {
		display: inline-flex;
		color: var(--etj-accent);
	}

	.engine-card h3 {
		margin: 0 0 0.35rem;
	}

	.engine-card p {
		margin: 0;
	}

	.engine-card--pending {
		border-style: dashed;
	}

	.engine-card__link,
	.engine-card__pending {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: auto;
		padding-top: 0.9rem;
		font-size: 0.82rem;
	}

	.engine-card__link {
		color: var(--etj-accent);
	}

	.engine-card:hover .engine-card__link {
		color: var(--etj-accent-hover);
	}

	.engine-card__pending {
		color: var(--etj-muted);
		font-family: var(--etj-font-mono);
	}

